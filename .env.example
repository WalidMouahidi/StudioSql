# Copier ce fichier vers .env et choisir un mot de passe de 12 caractères minimum.
STUDIOSQL_ADMIN_USERNAME=admin
STUDIOSQL_ADMIN_PASSWORD=

# Volume des données fictives au premier démarrage.
SEED_DEMO=1
DEMO_INVOICES=1000000

# Sans SQL_SOURCES explicite, Compose configure sqlserver/Billing et crm/CRM.
# Si vous définissez SQL_SOURCES, incluez les deux pour la démo multi-source.
